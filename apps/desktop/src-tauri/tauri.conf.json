{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Islet",
  "version": "0.1.4",
  "identifier": "io.github.renanravelli.islet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwODU0RjlDNjgxMjg0MTEKUldRUmhCSm9uRStGc0R1L0w3WUYzYlNTMmQvU1RIL3JnL3pkd1pCbStyclJmVmgvYjhkRS91R2QK",
      "endpoints": ["https://raw.githubusercontent.com/renanravelli/islet/updater/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "copyright": "© 2026 Renan Ravelli and the Islet contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
