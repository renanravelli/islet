{
  "$comment": "Every DOM dependency of the Meet adapter (docs/adr/0004). Strategies are tried in order; regexes are case-insensitive and every locale is tried. A key is verified only when it was confirmed in a real call; verifiedIn lists the Meet languages it was confirmed in. jsname/jscontroller values come from the owner's inspection of a real pt-BR call on 2026-11-03; Google can rename them, so each key keeps a label-based fallback. Unverified strategies are educated guesses. See docs/meet-adapter/calibration.md.",
  "version": 2,
  "updated": "2026-11-03",
  "keys": {
    "leaveButton": {
      "verified": true,
      "verifiedIn": ["pt-BR"],
      "required": true,
      "strategies": [
        { "css": "[jsname='CQylAd']" },
        { "ariaLabel": { "en": "^leave call", "pt-BR": "^sair da chamada" }, "css": "button" }
      ]
    },
    "micButton": {
      "verified": true,
      "verifiedIn": ["pt-BR"],
      "required": true,
      "strategies": [
        { "css": "[jsname='hw0c9'][data-is-muted]" },
        {
          "ariaLabel": {
            "en": "^turn (on|off) microphone",
            "pt-BR": "^(ativar|desativar) (o )?microfone"
          },
          "css": "button"
        }
      ],
      "state": [
        { "attribute": "data-is-muted", "on": "false", "off": "true" },
        {
          "ariaLabel": {
            "on": { "en": "^turn off microphone", "pt-BR": "^desativar (o )?microfone" },
            "off": { "en": "^turn on microphone", "pt-BR": "^ativar (o )?microfone" }
          }
        }
      ]
    },
    "camButton": {
      "verified": true,
      "verifiedIn": ["pt-BR"],
      "required": true,
      "strategies": [
        { "css": "[jsname='psRWwc'][data-is-muted]" },
        {
          "ariaLabel": {
            "en": "^turn (on|off) camera",
            "pt-BR": "^(ativar|desativar) (a )?c[âa]mera"
          },
          "css": "button"
        }
      ],
      "state": [
        { "attribute": "data-is-muted", "on": "false", "off": "true" },
        {
          "ariaLabel": {
            "on": { "en": "^turn off camera", "pt-BR": "^desativar (a )?c[âa]mera" },
            "off": { "en": "^turn on camera", "pt-BR": "^ativar (a )?c[âa]mera" }
          }
        }
      ]
    },
    "handButton": {
      "$comment": "Found by jsname in a real call; how it exposes its state is not confirmed yet.",
      "verified": false,
      "required": true,
      "strategies": [
        { "css": "[jsname='FpSaz']" },
        {
          "ariaLabel": {
            "en": "^(raise|lower) hand",
            "pt-BR": "^(levantar|abaixar) (a )?m[ãa]o"
          },
          "css": "button"
        }
      ],
      "state": [
        { "attribute": "aria-pressed", "on": "true", "off": "false" },
        {
          "ariaLabel": {
            "on": { "en": "^lower hand", "pt-BR": "^abaixar (a )?m[ãa]o" },
            "off": { "en": "^raise hand", "pt-BR": "^levantar (a )?m[ãa]o" }
          }
        }
      ]
    },
    "activeSpeaker": {
      "verified": false,
      "required": false,
      "strategies": [{ "css": "[data-participant-id][data-speaking='true']" }],
      "name": [{ "css": "[data-self-name]" }, { "css": "[data-participant-name]" }]
    },
    "participantCount": {
      "$comment": "The top bar's People button, found by hand in a real call; not confirmed through the adapter yet. span[data-avatar-count] also exists but may count only the avatars shown, so it is not used; the calibration report compares both.",
      "verified": false,
      "required": true,
      "strategies": [
        {
          "css": "div[role='button'][jsname='ocqpFe']",
          "labelledBy": { "en": "^people\\b", "pt-BR": "^pessoas\\b" }
        },
        { "ariaLabel": { "en": "^show everyone", "pt-BR": "^mostrar todos" }, "css": "button" }
      ],
      "count": [{ "css": ".fs3avc" }]
    },
    "mutedSpeakingNotice": {
      "verified": false,
      "required": false,
      "strategies": [
        {
          "text": {
            "en": "are you talking\\?.*(mic|microphone)",
            "pt-BR": "(voc[êe] est[áa] falando|est[áa] falando)\\?.*microfone"
          },
          "css": "[role='alert'], [aria-live]"
        }
      ]
    },
    "meetingTitle": {
      "$comment": "Found by hand in a real call; not confirmed through the adapter yet.",
      "verified": false,
      "required": false,
      "strategies": [{ "css": "div[jsname='NeC6gb'][jscontroller='yEvoid']" }]
    }
  }
}
