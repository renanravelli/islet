          "ariaLabel": {
            "en": "^turn (on|off) microphone",
            "pt-BR": "^(ativar|desativar) (o )?microfone"
          },
          "css": "button"
        }
      ],
      "state": [
        { "attribute": "data-is-muted", "on": "false", "off": "true" },
        {
          "ariaLabel": {
            "on": { "en": "^turn off microphone", "pt-BR": "^desativar (o )?microfone" },
            "off": { "en": "^turn on microphone", "pt-BR": "^ativar (o )?microfone" }
          }
        }
      ]
    },
    "camButton": {
      "verified": false,
      "required": true,
      "strategies": [
