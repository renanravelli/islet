{
  "name": "@islet/extension",
  "version": "0.1.4",
  "private": true,
  "description": "Chrome MV3 extension that reads Google Meet state for Islet.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/check-release-build.mjs",
    "dev": "vite build --watch --mode development",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:dev": "vite build --mode development"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@islet/protocol-ts": "workspace:*",
    "@types/chrome": "0.3.7",
    "jsdom": "30.1.3",
    "typescript": "~7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
